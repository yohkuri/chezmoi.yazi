{
  "permissions": {
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/format-lua-hook.sh\"",
            "statusMessage": "Formatting Lua"
          }
        ]
      }
    ]
  }
}
