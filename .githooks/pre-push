#!/bin/sh
# Refuse a push that would move `main` on GitHub; AGENTS.md says why, under
# "GitHub Flow". Every way of making commits -- a commit, merge, cherry-pick,
# revert, rebase or reset -- has to pass here to reach the remote.
#
# Branch protection refuses the same push on the server, for administrators
# too. This refuses it before the round trip, and says how to move the commits
# onto a branch. It has no override, since the server would refuse the push
# anyway.

# Only for this repository; `pre-commit` explains the matching.
remote_url=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
remote_url=${remote_url%/}
case "${remote_url%.git}" in
*[/@.]github.com[:/]yohkuri/chezmoi.yazi) ;;
*[/@.]github.com:443/yohkuri/chezmoi.yazi) ;;
*) exit 0 ;;
esac

refused=
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/heads/main) refused=1 ;;
	esac
done
[ -n "$refused" ] || exit 0

cat >&2 <<'MSG'
chezmoi.yazi: refusing a push to `main`.

  main moves only when a pull request is merged; branch protection would
  refuse this push on GitHub as well.

  Move main's commits to a topic branch, push it, and open a pull request:

      git switch -c <type>/<short-subject> main
      git branch -f main origin/main
      git push -u origin HEAD
      gh pr create
MSG
exit 1
