#!/bin/sh
# Refuse a push that would move `main` on GitHub; AGENTS.md says why, under
# "GitHub Flow". There is no override: branch protection refuses the same push
# on the server, for administrators too.

# Only for this repository: pushing a fork's main is an ordinary thing to do.
# GitHub accepts any case, a trailing slash and an optional `.git`, SSH with or
# without a user, and SSH on port 22 or on 443 at ssh.github.com, so the URL is
# folded before it is compared. The character before `github.com` keeps out a
# host that merely ends in it; the leading `/` gives one to SSH without a user.
remote_url=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
remote_url=${remote_url%/}
case "/${remote_url%.git}" in
*[/@.]github.com[:/]yohkuri/chezmoi.yazi) ;;
*[/@.]github.com:22/yohkuri/chezmoi.yazi | *[/@.]github.com:443/yohkuri/chezmoi.yazi) ;;
*) exit 0 ;;
esac

# Each line is `<local ref> <sha> <remote ref> <sha>`, so the remote ref is the
# only ref with a space on both sides.
grep -q ' refs/heads/main ' || exit 0

cat >&2 <<'MSG'
chezmoi.yazi: refusing a push to `main`.

  main moves only when a pull request is merged; branch protection would
  refuse this push on GitHub as well.

  Open a pull request from a topic branch instead. If the commits are on
  your local main, move them to one first:

      git switch -c <type>/<short-subject> main
      git branch -f main origin/main

  Then push the topic branch and open the pull request:

      git push -u origin HEAD
      gh pr create
MSG
exit 1
